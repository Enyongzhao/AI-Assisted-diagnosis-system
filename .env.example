# Copy to .env and fill in real values.
# docker-compose.yml injects env vars directly; .env is for non-Docker local dev.
# design_doc §7.1

SECRET_KEY=change-this-in-production
DEBUG=True

# ── Database (PostgreSQL 15) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=diagnosis_db
DB_USER=user
DB_PASSWORD=pass
DB_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: mock | claude | openai
# "mock" returns fixed JSON — no API key needed, safe for local dev
LLM_PROVIDER=mock
CLAUDE_API_KEY=
OPENAI_API_KEY=

# ── AWS S3 (PDF storage) ─────────────────────────────────────────────────────
# Leave empty to use local filesystem fallback (media/ directory)
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
